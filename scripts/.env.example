# copy to .env and edit
SSH_PUB_KEY_1=""
SSH_PUB_KEY_2=""

# --- k3s (only needed when building a k3s ISO) ---
# shared cluster secret, used by every node. e.g. openssl rand -hex 32
K3S_TOKEN="full token"
K3S_VERSION="v1.30.1+k3s1"
# API endpoint of the first server node (server-1), port 6443.
# Joining servers pass it to k3s as --server, agents consume it as K3S_URL.
SERVER_REGISTER_URL="https://192.168.1.102:6443"

# --- RKE2 (only needed when building an RKE2 ISO) ---
# shared cluster secret, used by every node. e.g. openssl rand -hex 32
RKE2_TOKEN="full token"
RKE2_VERSION="v1.34.10+rke2r1"
# Supervisor endpoint of the first server node (server-1). Note port 9345, not
# 6443: RKE2 registers joining servers and agents on a separate supervisor port.
RKE2_SERVER_REGISTER_URL="https://192.168.1.102:9345"
