# copy to .env and edit
SSH_PUB_KEY_1=""
SSH_PUB_KEY_2=""
# shared cluster secret, used by every node. e.g. openssl rand -hex 32
K3S_TOKEN="full token"
K3S_VERSION="v1.30.1+k3s1"
# API endpoint of the first server node (server-1), port 6443.
# Joining servers pass it to k3s as --server, agents consume it as K3S_URL.
SERVER_REGISTER_URL="https://192.168.1.102:6443"
